{
  "name": "dsh-canvas-tsx-sidebar",
  "version": "0.3.1",
  "description": "DSH web plugin (dsh-better-sidebar consumer) for the DSH 0.1.5 line: render Qoder Canvas `*.canvas.tsx` reports as a structured page in the right sidebar. Static parse only — no code execution.",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drscrewdriver/dsh-canvas-tsx-sidebar.git"
  },
  "homepage": "https://github.com/drscrewdriver/dsh-canvas-tsx-sidebar#readme",
  "bugs": {
    "url": "https://github.com/drscrewdriver/dsh-canvas-tsx-sidebar/issues"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "better-sidebar",
    "canvas",
    "qoder",
    "report"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.1.5-rc.1 <0.2.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-locale": ">=0.1.5-rc.1 <0.2.0-0",
    "dsh-better-sidebar": ">=0.18.1",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "dsh-better-sidebar": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc -p tsconfig.build.json && tsdown --config-loader tsx",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "test": "vitest run",
    "audit:bundle": "node scripts/audit-bundle.cjs lib/client.js",
    "clean": "node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\"",
    "mount:check": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/mount-check.ps1",
    "release:015": "npm publish --tag dsh-0.1.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.0.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.7",
    "dsh-better-sidebar": "^0.19.1",
    "jsdom": "^26.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsx": "^4.23.12",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
